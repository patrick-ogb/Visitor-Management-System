@page "/dashboard"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@using VMS.Client.DTOs.Invitations
@using VMS.Client.DTOs.Common
@using VMS.Client.DTOs.Dashboard
@using ClosedXML.Excel
@inject HttpClient Http
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JSRuntime
@attribute [Authorize(Policy = "RequireAdmin")]

<PageTitle>Dashboard</PageTitle>

<div class="lfz-admin-container">
    <div class="lfz-admin-main">
        <!-- Header Section -->
        <div class="lfz-admin-header">
            <span class="lfz-admin-title">ADMIN</span>
            <div class="lfz-admin-user-section">
                <div class="lfz-admin-notification-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path>
                        <path d="M13.73 21a2 2 0 0 1-3.46 0"></path>
                    </svg>
                </div>
                <div class="lfz-admin-profile">
                    <div class="lfz-admin-avatar">
                        <img src="https://ui-avatars.com/api/?name=Tochukwu+Ndefo&background=1A3B6A&color=fff&size=128" alt="Profile" />
                    </div>
                    <div class="lfz-admin-user-info">
                        <span class="lfz-admin-user-name">Tochukwu Ndefo</span>
                        <span class="lfz-admin-user-email">tndefo@lfz.com</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Metric Cards Section -->
        <div class="lfz-admin-metrics">
            <!-- Total Visitors Card -->
            <div class="lfz-admin-metric-card metric-visitors">
                <div class="metric-wave-bg"></div>
                <span class="metric-label">Total Visitors</span>
                <span class="metric-value">@totalVisitors</span>
                <div class="metric-icon visitors-icon">
                    <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
                        <circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
                        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                </div>
            </div>

            <!-- Total Enterprises Card -->
            <div class="lfz-admin-metric-card metric-enterprises">
                <div class="metric-wave-bg"></div>
                <span class="metric-label">Total Enterprises</span>
                <span class="metric-value">@totalEnterprises</span>
                <div class="metric-icon enterprises-icon">
                    <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="50" height="50" rx="8" fill="#007AFF" fill-opacity="0.08"/>
                        <path d="M16 16H18.25V20.5H16V16ZM16 22.75H18.25V27.25H16V22.75ZM22.75 16H25V20.5H22.75V16ZM22.75 22.75H25V27.25H22.75V22.75ZM16 29.5H18.25V34H16V29.5ZM22.75 29.5H25V34H22.75V29.5Z" fill="#007AFF"/>
                        <path d="M40.75 22.75C40.75 22.1533 40.5129 21.581 40.091 21.159C39.669 20.7371 39.0967 20.5 38.5 20.5H31.75V11.5C31.75 10.9033 31.5129 10.331 31.091 9.90901C30.669 9.48705 30.0967 9.25 29.5 9.25H11.5C10.9033 9.25 10.331 9.48705 9.90901 9.90901C9.48705 10.331 9.25 10.9033 9.25 11.5V40.75H40.75V22.75ZM11.5 11.5H29.5V38.5H11.5V11.5ZM31.75 38.5V22.75H38.5V38.5H31.75Z" fill="#007AFF"/>
                    </svg>
                </div>
            </div>

            <!-- Walk-In Requests Card -->
            <div class="lfz-admin-metric-card metric-walkins">
                <div class="metric-wave-bg"></div>
                <span class="metric-label">Walk-In Requests</span>
                <span class="metric-value">@walkInRequests</span>
                <div class="metric-icon walkins-icon">
                    <svg width="50" height="50" viewBox="0 0 50 50" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <rect width="50" height="50" rx="8" fill="#52C752" fill-opacity="0.08"/>
                        <path d="M29.0931 40.9131L25.1014 32.8455L21.9451 28.8102C21.4788 28.0213 21.2328 27.1216 21.2329 26.2052V17.125M21.2329 17.125H22.3346C22.7061 17.1249 23.0739 17.198 23.4171 17.3401C23.7603 17.4821 24.0721 17.6904 24.3348 17.953C24.5975 18.2157 24.8058 18.5274 24.948 18.8706C25.0901 19.2137 25.1633 19.5815 25.1633 19.953V32.8455M21.2329 17.125C18.613 17.125 15.9932 22.3654 15.9932 22.3654V27.6051M33.0229 26.2952L28.3752 23.2422M18.9906 40.6347L22.7502 35.125" stroke="#34C759" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M25.1633 14.5052C26.6102 14.5052 27.7831 13.3322 27.7831 11.8853C27.7831 10.4384 26.6102 9.26547 25.1633 9.26547C23.7164 9.26547 22.5435 10.4384 22.5435 11.8853C22.5435 13.3322 23.7164 14.5052 25.1633 14.5052Z" stroke="#34C759" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
        </div>

        <!-- Charts Section -->
        <div class="lfz-admin-charts">
            <!-- Visitors by Day Chart -->
            <div class="lfz-admin-chart-container">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <span class="chart-title">Visitors by Day</span>
                    <div class="chart-view-toggle">
                        <button class="toggle-btn @(chartViewMode == "ByDate" ? "active" : "")" @onclick='() => SwitchChartView("ByDate")'>
                            By Date
                        </button>
                        <button class="toggle-btn @(chartViewMode == "ByDayOfWeek" ? "active" : "")" @onclick='() => SwitchChartView("ByDayOfWeek")'>
                            By Day of Week
                        </button>
                    </div>
                </div>
                <div class="chart-content">
                    @if (isLoadingChart)
                    {
                        <div style="text-align: center; padding: 2rem;">
                            <span>Loading chart data...</span>
                        </div>
                    }
                    else if (visitorsByDay == null || visitorsByDay.Count == 0)
                    {
                        <div style="text-align: center; padding: 2rem;">
                            <span>No data available</span>
                        </div>
                    }
                    else
                    {
                        <svg class="visitors-chart" viewBox="0 0 500 250" preserveAspectRatio="none">
                        @{
                            var maxCount = visitorsByDay.Count > 0 ? visitorsByDay.Max(v => v.Count) : 0;
                            var yAxisMax = maxCount > 325 ? ((maxCount / 50) + 1) * 50 : 325;
                            var chartHeight = 180;
                            var chartWidth = 400;
                            var startX = 50;
                            var startY = 20;
                            var endY = 200;
                            var dataPointCount = visitorsByDay.Count > 0 ? visitorsByDay.Count : 1;
                            var daySpacing = dataPointCount > 1 ? chartWidth / (dataPointCount - 1.0) : chartWidth;
                            
                            // Y-axis labels
                            @for (int i = 0; i <= 5; i++)
                            {
                                var value = (yAxisMax / 5) * (5 - i);
                                var yPos = startY + (chartHeight / 5) * i;
                                @((MarkupString)$"<text x=\"10\" y=\"{yPos + 5}\" class=\"axis-label\">{value}</text>")
                            }
                            
                            // X-axis labels - adapt based on view mode
                            @if (chartViewMode == "ByDate")
                            {
                                // ByDate: Show formatted dates
                                @for (int i = 0; i < visitorsByDay.Count; i++)
                                {
                                    var xPos = startX + (daySpacing * i);
                                    var dateLabel = visitorsByDay[i].DateLabel;
                                    @((MarkupString)$"<text x=\"{xPos - 20}\" y=\"220\" class=\"axis-label\">{dateLabel}</text>")
                                }
                            }
                            else
                            {
                                // ByDayOfWeek: Show day names
                                @for (int i = 0; i < visitorsByDay.Count; i++)
                                {
                                    var xPos = startX + (daySpacing * i);
                                    var dayName = visitorsByDay[i].Day;
                                    @((MarkupString)$"<text x=\"{xPos - 15}\" y=\"220\" class=\"axis-label\">{dayName}</text>")
                                }
                            }
                            
                            // Grid lines
                            <line x1="@startX" y1="@startY" x2="@startX" y2="@endY" stroke="#E0E0E0" stroke-width="1"/>
                            @for (int i = 0; i <= 5; i++)
                            {
                                var yPos = startY + (chartHeight / 5) * i;
                                <line x1="@startX" y1="@yPos" x2="@(startX + chartWidth)" y2="@yPos" stroke="#E0E0E0" stroke-width="1"/>
                            }
                            <line x1="@startX" y1="@endY" x2="@(startX + chartWidth)" y2="@endY" stroke="#E0E0E0" stroke-width="1"/>
                            
                            // Line chart
                            var pathPoints = new List<(double x, double y)>();
                            for (int i = 0; i < visitorsByDay.Count; i++)
                            {
                                var day = visitorsByDay[i];
                                var x = startX + (daySpacing * i);
                                var normalizedCount = yAxisMax > 0 ? (double)day.Count / yAxisMax : 0;
                                var y = endY - (normalizedCount * chartHeight);
                                pathPoints.Add((x, y));
                            }
                            
                            if (pathPoints.Count > 0)
                            {
                                var pathString = string.Join(" ", pathPoints.Select((p, idx) => 
                                    idx == 0 ? $"M {p.x:F1},{p.y:F1}" : $"L {p.x:F1},{p.y:F1}"));
                                
                                <path d="@pathString" 
                                      stroke="#4CAF50" 
                                      stroke-width="3" 
                                      fill="none" 
                                      class="chart-line"/>
                                
                                @foreach (var point in pathPoints)
                                {
                                    <circle cx="@point.x" cy="@point.y" r="4" fill="#4CAF50"/>
                                }
                                
                                // Tooltip for highest point
                                @if (pathPoints.Count > 1 && visitorsByDay.Count > 1)
                                {
                                    var maxIndex = pathPoints.Select((p, idx) => (p.y, idx)).OrderBy(x => x.y).First().idx;
                                    var tooltipLabel = chartViewMode == "ByDate" 
                                        ? visitorsByDay[maxIndex].DateLabel 
                                        : visitorsByDay[maxIndex].Day;
                                    <g class="chart-tooltip" transform="translate(@(pathPoints[maxIndex].x), @(pathPoints[maxIndex].y - 30))">
                                        <rect x="-40" y="-25" width="80" height="30" rx="4" fill="white" stroke="#E0E0E0"/>
                                        @((MarkupString)$"<text x=\"0\" y=\"-8\" text-anchor=\"middle\" class=\"tooltip-text\">{tooltipLabel}</text>")
                                        @((MarkupString)$"<text x=\"0\" y=\"5\" text-anchor=\"middle\" class=\"tooltip-text\">visitors : {visitorsByDay[maxIndex].Count}</text>")
                                    </g>
                                }
                            }
                        }
                        </svg>
                    }
                </div>
            </div>

            <!-- Top Enterprises Pie Chart -->
            <div class="lfz-admin-chart-container">
                <span class="chart-title">Top Enterprises by Visitor Count</span>
                <div class="chart-content pie-chart-content">
                    @if (isLoadingChart)
                    {
                        <div style="text-align: center; padding: 2rem;">
                            <span>Loading chart data...</span>
                        </div>
                    }
                    else if (topEnterprises == null || topEnterprises.Count == 0)
                    {
                        <div style="text-align: center; padding: 2rem;">
                            <span>No data available</span>
                        </div>
                    }
                    else
                    {
                        <svg class="pie-chart" viewBox="0 0 220 220" width="220" height="220">
                        @{
                            var pieSize = 220;
                            var center = pieSize / 2.0;
                            var radius = 80.0;
                            
                            double currentAngle = -90;
                            // Colors matching the image: Kellogg's (dark blue), Dano (orange), Dangote (purple-blue), INSIGNIA (bright blue), Colgate (light blue)
                            var segmentColors = new[] { "#002B82", "#FF9500", "#5856D6", "#005AFF", "#99BAFF" };
                            
                            for (int i = 0; i < topEnterprises.Count; i++)
                            {
                                var enterprise = topEnterprises[i];
                                var percentage = enterprise.Percentage;
                                var angle = (percentage / 100.0) * 360.0;
                                var startAngle = currentAngle;
                                var endAngle = currentAngle + angle;
                                
                                // Calculate arc path for pie chart (from center to edge)
                                var startAngleRad = (startAngle * Math.PI) / 180.0;
                                var endAngleRad = (endAngle * Math.PI) / 180.0;
                                
                                var x1 = center + radius * Math.Cos(startAngleRad);
                                var y1 = center + radius * Math.Sin(startAngleRad);
                                var x2 = center + radius * Math.Cos(endAngleRad);
                                var y2 = center + radius * Math.Sin(endAngleRad);
                                
                                var largeArcFlag = angle > 180.0 ? 1 : 0;
                                // Pie chart path: Move to center, line to start point, arc to end point, close path
                                var path = $"M {center:F2} {center:F2} L {x1:F2} {y1:F2} A {radius:F2} {radius:F2} 0 {largeArcFlag} 1 {x2:F2} {y2:F2} Z";
                                
                                <path d="@path" fill="@segmentColors[i]" class="pie-segment"/>
                                
                                currentAngle = endAngle;
                            }
                        }
                        </svg>
                        <div class="pie-legend">
                            @for (int i = 0; i < topEnterprises.Count; i++)
                            {
                                var enterprise = topEnterprises[i];
                                // Colors matching the image: Kellogg's (dark blue), Dano (orange), Dangote (purple-blue), INSIGNIA (bright blue), Colgate (light blue)
                                var legendColors = new[] { "#002B82", "#FF9500", "#5856D6", "#005AFF", "#99BAFF" };
                                <div class="legend-item">
                                    <div class="legend-color" style="background-color: @legendColors[i]"></div>
                                    <span class="legend-label">@enterprise.Name</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Invitations Table Section -->
        <div class="lfz-admin-invitations">
            <span class="invitations-title">Invitations</span>
            
            <!-- Search and Filters -->
            <div class="invitations-controls">
                <div class="search-box">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8"></circle>
                        <path d="m21 21-4.35-4.35"></path>
                    </svg>
                    <input type="text" placeholder="Search by name or Invitation ID" class="search-input" @bind="searchTerm" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" />
                </div>
                <div class="filter-dropdown-container" @onclick:stopPropagation="true">
                    <div class="filter-header" @onclick="ToggleFilterDropdown">
                        <span>@GetFilterDisplayText()</span>
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(showFilterDropdown ? "caret-up" : "caret-down")">
                            <polyline points="@(showFilterDropdown ? "18 15 12 9 6 15" : "6 9 12 15 18 9")"></polyline>
                        </svg>
                    </div>
                    @if (showFilterDropdown)
                    {
                        <div class="filter-dropdown-menu">
                            <div class="filter-option" @onclick='() => SelectFilter("")'>Select</div>
                            <div class="filter-option" @onclick='() => SelectFilter("Approved")'>Approved</div>
                            <div class="filter-option" @onclick='() => SelectFilter("Pending")'>Pending</div>
                            <div class="filter-option" @onclick='() => SelectFilter("CheckIn")'>Checked In</div>
                            <div class="filter-option" @onclick='() => SelectFilter("CheckOut")'>Check Out</div>
                            <div class="filter-option" @onclick='() => SelectFilter("Rejected")'>Rejected</div>
                            <div class="filter-option" @onclick='() => SelectFilter("Cancelled")'>Cancelled</div>
                        </div>
                    }
                </div>
                <div class="export-dropdown-container" @onclick:stopPropagation="true">
                    <div class="export-header" @onclick="ToggleExportDropdown" style="@(isExporting ? "opacity: 0.6; pointer-events: none;" : "")">
                        <span>Export</span>
                        @if (isExporting)
                        {
                            <span style="margin-left: 8px; font-size: 12px;">Exporting...</span>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="@(showExportDropdown ? "caret-up" : "caret-down")">
                                <polyline points="@(showExportDropdown ? "18 15 12 9 6 15" : "6 9 12 15 18 9")"></polyline>
                            </svg>
                        }
                    </div>
                    @if (showExportDropdown && !isExporting)
                    {
                        <div class="export-dropdown-menu">
                            <div class="export-option" @onclick='() => SelectExport("CSV")'>CSV</div>
                            <div class="export-option" @onclick='() => SelectExport("Excel")'>Excel</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Table -->
            <div class="table-wrapper">
                <table class="invitations-table">
                    <thead>
                        <tr>
                            <th>INVITATION ID</th>
                            <th>VISITOR</th>
                            <th>HOST</th>
                            <th>DATE</th>
                            <th>STATUS</th>
                            <th>ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (isLoadingInvitations)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 20px;">
                                    Loading invitations...
                                </td>
                            </tr>
                        }
                        else if (invitations.Count == 0)
                        {
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 20px;">
                                    No invitations found.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var invitation in invitations)
                            {
                                var displayStatus = GetDisplayStatus(invitation.Status);
                                <tr>
                                    <td>@invitation.InvitationNo</td>
                                    <td>@invitation.GuestName</td>
                                    <td>@invitation.HostName</td>
                                    <td>@FormatDate(invitation.ExpectedArrival)</td>
                                    <td>
                                        <span class="status-badge status-@displayStatus.ToLower().Replace(" ", "")">@displayStatus</span>
                                    </td>
                                    <td>
                                        <div class="action-buttons">
                                            <button class="action-btn view-btn" title="View" @onclick='() => OpenDetailsModal(invitation)'>
                                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                </svg>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            @if (pagedResponse != null)
            {
                <div class="pagination">
                    <button class="pagination-btn prev-btn" @onclick="GoToPreviousPage" disabled="@(!pagedResponse.HasPreviousPage)">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="15 18 9 12 15 6"></polyline>
                        </svg>
                        <span>Previous Page</span>
                    </button>
                    <div class="pagination-info">
                        <span>Page</span>
                        <div class="page-number">@pagedResponse.PageNumber</div>
                        <span>of @pagedResponse.TotalPages</span>
                    </div>
                    <button class="pagination-btn next-btn" @onclick="GoToNextPage" disabled="@(!pagedResponse.HasNextPage)">
                        <span>Next Page</span>
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Visit Details Modal Overlay -->
@if (showDetailsModal)
{
    <div class="modal-overlay @(isModalVisible ? "show" : "")" @onclick="CloseDetailsModal">
        <div class="modal-content @(isModalVisible ? "show" : "")" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2 class="modal-title">Visit Details</h2>
                <button class="modal-close-btn-top" @onclick="CloseDetailsModal" aria-label="Close" type="button">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <div class="modal-body">
                @if (selectedInvitation != null)
                {
                    var displayStatus = GetDisplayStatus(selectedInvitation.Status);
                    <div class="detail-field">
                        <span class="detail-label">Name of Host</span>
                        <div class="detail-value-with-badge">
                            <span class="detail-value">@selectedInvitation.HostName</span>
                            <span class="status-badge status-@displayStatus.ToLower().Replace(" ", "")">@displayStatus</span>
                        </div>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Email</span>
                        <span class="detail-value">@(selectedInvitation.HostEmail ?? "N/A")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Name of Guest</span>
                        <span class="detail-value">@selectedInvitation.GuestName</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Phone Number</span>
                        <span class="detail-value">@selectedInvitation.GuestPhone</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Arrival Time</span>
                        <span class="detail-value">@(selectedInvitation.CheckedInAt?.ToString("dd/MM/yyyy | hh:mmtt") ?? selectedInvitation.ExpectedArrival.ToString("dd/MM/yyyy | hh:mmtt"))</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Departure Time</span>
                        <span class="detail-value">@selectedInvitation.ExpectedDeparture.ToString("dd/MM/yyyy | hh:mmtt")</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Number of Guests</span>
                        <span class="detail-value">@(selectedInvitation.NumberOfAdditionalGuests + 1)</span>
                    </div>
                    <div class="detail-field">
                        <span class="detail-label">Number of Vehicles</span>
                        <span class="detail-value">@(selectedInvitation.Vehicles?.Count ?? 0)</span>
                    </div>
                    @if (selectedInvitation.Vehicles != null && selectedInvitation.Vehicles.Count > 0)
                    {
                        @for (int i = 0; i < selectedInvitation.Vehicles.Count; i++)
                        {
                            var vehicle = selectedInvitation.Vehicles[i];
                            <div class="detail-field">
                                <span class="detail-label">Vehicle @(i + 1) - Plate Number</span>
                                <span class="detail-value">@vehicle.PlateNumber</span>
                            </div>
                        }
                    }
                }
            </div>
            <div class="modal-footer">
                <button class="modal-close-btn-bottom" @onclick="CloseDetailsModal" type="button">Close</button>
            </div>
        </div>
    </div>
}

@code {
    // Real data - metrics
    private int totalVisitors = 0;
    private int totalEnterprises = 0;
    private int walkInRequests = 0;

    // Real data - Visitors by Day
    private List<VisitorsByDayDto> visitorsByDay = new();

    // Real data - Top Enterprises
    private List<TopEnterpriseDto> topEnterprises = new();

    // Real data - Invitations
    private List<InvitationDto> invitations = new();
    private PagedResponse<InvitationDto>? pagedResponse;
    private int? currentPage = 1;
    private int pageSize = 10;

    // Loading and error states
    private bool isLoadingMetrics = true;
    private bool isLoadingChart = true;
    private bool isLoadingInvitations = true;
    private string? errorMessage;

    // Chart view mode
    private string chartViewMode = "ByDate"; // Default to ByDate

    // Modal state
    private bool showDetailsModal = false;
    private bool isModalVisible = false;
    private InvitationDto? selectedInvitation = null;

    // Filter state
    private string selectedFilter = string.Empty;
    private bool showFilterDropdown = false;

    // Export state
    private bool showExportDropdown = false;
    private bool isExporting = false;

    // Search state
    private string searchTerm = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardMetrics();
        await LoadVisitorsByDay();
        await LoadTopEnterprises();
        await LoadInvitations();
    }

    private async Task LoadDashboardMetrics()
    {
        isLoadingMetrics = true;
        try
        {
            var response = await Http.GetFromJsonAsync<BaseResponse<DashboardMetricsDto>>("api/Dashboard/metrics");
            if (response != null && response.Success && response.Data != null)
            {
                totalVisitors = response.Data.TotalVisitors;
                totalEnterprises = response.Data.TotalEnterprises;
                walkInRequests = response.Data.WalkInRequests;
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to load dashboard metrics.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading dashboard metrics: {ex.Message}";
        }
        finally
        {
            isLoadingMetrics = false;
        }
    }

    private async Task LoadVisitorsByDay()
    {
        isLoadingChart = true;
        try
        {
            var url = $"api/Dashboard/visitors-by-day?viewMode={chartViewMode}";
            var response = await Http.GetFromJsonAsync<BaseResponse<List<VisitorsByDayDto>>>(url);
            if (response != null && response.Success && response.Data != null)
            {
                visitorsByDay = response.Data;
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to load visitors by day data.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading visitors by day: {ex.Message}";
        }
        finally
        {
            isLoadingChart = false;
        }
    }

    private async Task SwitchChartView(string viewMode)
    {
        if (chartViewMode != viewMode)
        {
            chartViewMode = viewMode;
            await LoadVisitorsByDay();
        }
    }

    private async Task LoadTopEnterprises()
    {
        isLoadingChart = true;
        try
        {
            var response = await Http.GetFromJsonAsync<BaseResponse<List<TopEnterpriseDto>>>("api/Dashboard/top-enterprises?count=5");
            if (response != null && response.Success && response.Data != null)
            {
                topEnterprises = response.Data;
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to load top enterprises data.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading top enterprises: {ex.Message}";
        }
        finally
        {
            isLoadingChart = false;
        }
    }

    private async Task LoadInvitations(int? pageNumber = null, string? searchTermParam = null, string? statusFilter = null)
    {
        isLoadingInvitations = true;
        try
        {
            var page = pageNumber ?? currentPage;
            var search = searchTermParam ?? searchTerm;
            var status = statusFilter ?? MapFilterToApiStatus(selectedFilter);
            
            var queryParams = $"PageNumber={page}&PageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(search))
            {
                queryParams += $"&SearchTerm={Uri.EscapeDataString(search.Trim())}";
            }
            if (!string.IsNullOrWhiteSpace(status))
            {
                queryParams += $"&Status={Uri.EscapeDataString(status)}";
            }
            
            var response = await Http.GetFromJsonAsync<BaseResponse<PagedResponse<InvitationDto>>>($"api/Invitations?{queryParams}");
            if (response != null && response.Success && response.Data != null)
            {
                pagedResponse = response.Data;
                invitations = response.Data.Items;
                currentPage = response.Data.PageNumber;
            }
            else
            {
                errorMessage = response?.Message ?? "Failed to load invitations.";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading invitations: {ex.Message}";
        }
        finally
        {
            isLoadingInvitations = false;
        }
    }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            // Reset to page 1 when performing a new search
            currentPage = 1;
            var status = MapFilterToApiStatus(selectedFilter);
            await LoadInvitations(1, searchTerm, status);
        }
    }

    private string? MapFilterToApiStatus(string filterValue)
    {
        if (string.IsNullOrEmpty(filterValue) || filterValue == "Select")
        {
            return null;
        }

        return filterValue switch
        {
            "Pending" => "PendingApproval",
            "CheckIn" => "CheckedIn",
            "CheckOut" => "Completed",
            "Approved" => "Approved",
            "Rejected" => "Rejected",
            "Cancelled" => "Cancelled",
            _ => null
        };
    }

    private string GetDisplayStatus(string status)
    {
        return status switch
        {
            "Completed" => "Exited",
            "PendingApproval" => "Pending",
            "CheckedIn" => "Checked In",
            _ => status
        };
    }

    private string FormatDate(DateTime date)
    {
        return date.ToString("yyyy-MM-dd / HH:mm");
    }

    private void OpenDetailsModal(InvitationDto invitation)
    {
        selectedInvitation = invitation;
        showDetailsModal = true;
        StateHasChanged();
        
        // Trigger slide-in animation after render
        Task.Delay(10).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                isModalVisible = true;
                StateHasChanged();
            });
        });
    }

    private void CloseDetailsModal()
    {
        isModalVisible = false;
        StateHasChanged();
        
        // Wait for animation to complete before removing from DOM
        Task.Delay(300).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                showDetailsModal = false;
                selectedInvitation = null;
                StateHasChanged();
            });
        });
    }

    private async Task GoToPreviousPage()
    {
        if (pagedResponse != null && pagedResponse.HasPreviousPage)
        {
            var status = MapFilterToApiStatus(selectedFilter);
            await LoadInvitations(currentPage - 1, null, status);
        }
    }

    private async Task GoToNextPage()
    {
        if (pagedResponse != null && pagedResponse.HasNextPage)
        {
            var status = MapFilterToApiStatus(selectedFilter);
            await LoadInvitations(currentPage + 1, null, status);
        }
    }

    private void ToggleFilterDropdown()
    {
        showFilterDropdown = !showFilterDropdown;
        StateHasChanged();
    }

    private async Task SelectFilter(string filterValue)
    {
        selectedFilter = filterValue;
        showFilterDropdown = false;
        
        // Reset to page 1 when filter changes
        currentPage = 1;
        
        // Map filter value to API status and load invitations
        var status = MapFilterToApiStatus(filterValue);
        await LoadInvitations(1, null, status);
        
        StateHasChanged();
    }

    private string GetFilterDisplayText()
    {
        if (string.IsNullOrEmpty(selectedFilter) || selectedFilter == "Select")
        {
            return "Filters";
        }

        return selectedFilter switch
        {
            "CheckIn" => "Checked In",
            "CheckOut" => "Check Out",
            _ => selectedFilter
        };
    }

    private void ToggleExportDropdown()
    {
        showExportDropdown = !showExportDropdown;
        StateHasChanged();
    }

    private async Task<List<InvitationDto>> FetchAllInvitationsForExport()
    {
        var allInvitations = new List<InvitationDto>();
        var page = 1;
        var hasMorePages = true;
        var search = searchTerm;
        var status = MapFilterToApiStatus(selectedFilter);

        while (hasMorePages)
        {
            var queryParams = $"PageNumber={page}&PageSize=1000"; // Use large page size to minimize API calls
            if (!string.IsNullOrWhiteSpace(search))
            {
                queryParams += $"&SearchTerm={Uri.EscapeDataString(search.Trim())}";
            }
            if (!string.IsNullOrWhiteSpace(status))
            {
                queryParams += $"&Status={Uri.EscapeDataString(status)}";
            }

            var response = await Http.GetFromJsonAsync<BaseResponse<PagedResponse<InvitationDto>>>($"api/Invitations?{queryParams}");
            if (response != null && response.Success && response.Data != null)
            {
                allInvitations.AddRange(response.Data.Items);
                hasMorePages = response.Data.HasNextPage;
                page++;
            }
            else
            {
                hasMorePages = false;
            }
        }

        return allInvitations;
    }

    private string GenerateCsvContent(List<InvitationDto> invitations)
    {
        var csv = new System.Text.StringBuilder();
        
        // Headers
        csv.AppendLine("Invitation ID,Visitor Name,Visitor Phone,Visitor Email,Host Name,Host Email,Enterprise,Status,Expected Arrival,Expected Departure,Checked In At,Number of Guests,Vehicles,Created At");
        
        // Data rows
        foreach (var invitation in invitations)
        {
            var vehicles = invitation.Vehicles != null && invitation.Vehicles.Count > 0
                ? string.Join("; ", invitation.Vehicles.Select(v => $"{v.PlateNumber} ({v.Model ?? "N/A"} {v.Color ?? ""})".Trim()))
                : "None";
            
            var displayStatus = GetDisplayStatus(invitation.Status);
            
            csv.AppendLine($"{EscapeCsvField(invitation.InvitationNo)}," +
                          $"{EscapeCsvField(invitation.GuestName)}," +
                          $"{EscapeCsvField(invitation.GuestPhone)}," +
                          $"{EscapeCsvField(invitation.GuestEmail ?? "")}," +
                          $"{EscapeCsvField(invitation.HostName)}," +
                          $"{EscapeCsvField(invitation.HostEmail ?? "")}," +
                          $"{EscapeCsvField(invitation.EnterpriseName ?? "")}," +
                          $"{EscapeCsvField(displayStatus)}," +
                          $"{EscapeCsvField(invitation.ExpectedArrival.ToString("yyyy-MM-dd HH:mm"))}," +
                          $"{EscapeCsvField(invitation.ExpectedDeparture.ToString("yyyy-MM-dd HH:mm"))}," +
                          $"{EscapeCsvField(invitation.CheckedInAt?.ToString("yyyy-MM-dd HH:mm") ?? "")}," +
                          $"{(invitation.NumberOfAdditionalGuests + 1)}," +
                          $"{EscapeCsvField(vehicles)}," +
                          $"{EscapeCsvField(invitation.CreatedAt.ToString("yyyy-MM-dd HH:mm"))}");
        }
        
        return csv.ToString();
    }

    private string EscapeCsvField(string field)
    {
        if (string.IsNullOrEmpty(field))
            return "";
        
        // If field contains comma, quote, or newline, wrap in quotes and escape quotes
        if (field.Contains(',') || field.Contains('"') || field.Contains('\n') || field.Contains('\r'))
        {
            return "\"" + field.Replace("\"", "\"\"") + "\"";
        }
        
        return field;
    }

    private byte[] GenerateExcelFile(List<InvitationDto> invitations)
    {
        using var workbook = new XLWorkbook();
        var worksheet = workbook.Worksheets.Add("Invitations");
        
        // Headers
        worksheet.Cell(1, 1).Value = "Invitation ID";
        worksheet.Cell(1, 2).Value = "Visitor Name";
        worksheet.Cell(1, 3).Value = "Visitor Phone";
        worksheet.Cell(1, 4).Value = "Visitor Email";
        worksheet.Cell(1, 5).Value = "Host Name";
        worksheet.Cell(1, 6).Value = "Host Email";
        worksheet.Cell(1, 7).Value = "Enterprise";
        worksheet.Cell(1, 8).Value = "Status";
        worksheet.Cell(1, 9).Value = "Expected Arrival";
        worksheet.Cell(1, 10).Value = "Expected Departure";
        worksheet.Cell(1, 11).Value = "Checked In At";
        worksheet.Cell(1, 12).Value = "Number of Guests";
        worksheet.Cell(1, 13).Value = "Vehicles";
        worksheet.Cell(1, 14).Value = "Created At";
        
        // Format header row
        var headerRange = worksheet.Range(1, 1, 1, 14);
        headerRange.Style.Font.Bold = true;
        headerRange.Style.Fill.BackgroundColor = XLColor.LightGray;
        
        // Data rows
        for (int i = 0; i < invitations.Count; i++)
        {
            var invitation = invitations[i];
            var row = i + 2;
            
            var vehicles = invitation.Vehicles != null && invitation.Vehicles.Count > 0
                ? string.Join("; ", invitation.Vehicles.Select(v => $"{v.PlateNumber} ({v.Model ?? "N/A"} {v.Color ?? ""})".Trim()))
                : "None";
            
            var displayStatus = GetDisplayStatus(invitation.Status);
            
            worksheet.Cell(row, 1).Value = invitation.InvitationNo;
            worksheet.Cell(row, 2).Value = invitation.GuestName;
            worksheet.Cell(row, 3).Value = invitation.GuestPhone;
            worksheet.Cell(row, 4).Value = invitation.GuestEmail ?? "";
            worksheet.Cell(row, 5).Value = invitation.HostName;
            worksheet.Cell(row, 6).Value = invitation.HostEmail ?? "";
            worksheet.Cell(row, 7).Value = invitation.EnterpriseName ?? "";
            worksheet.Cell(row, 8).Value = displayStatus;
            worksheet.Cell(row, 9).Value = invitation.ExpectedArrival;
            worksheet.Cell(row, 9).Style.DateFormat.Format = "yyyy-mm-dd hh:mm";
            worksheet.Cell(row, 10).Value = invitation.ExpectedDeparture;
            worksheet.Cell(row, 10).Style.DateFormat.Format = "yyyy-mm-dd hh:mm";
            if (invitation.CheckedInAt.HasValue)
            {
                worksheet.Cell(row, 11).Value = invitation.CheckedInAt.Value;
                worksheet.Cell(row, 11).Style.DateFormat.Format = "yyyy-mm-dd hh:mm";
            }
            worksheet.Cell(row, 12).Value = invitation.NumberOfAdditionalGuests + 1;
            worksheet.Cell(row, 13).Value = vehicles;
            worksheet.Cell(row, 14).Value = invitation.CreatedAt;
            worksheet.Cell(row, 14).Style.DateFormat.Format = "yyyy-mm-dd hh:mm";
        }
        
        // Auto-size columns
        worksheet.Columns().AdjustToContents();
        
        using var stream = new MemoryStream();
        workbook.SaveAs(stream);
        return stream.ToArray();
    }

    private async Task DownloadFile(string content, string fileName, string contentType)
    {
        await JSRuntime.InvokeVoidAsync("downloadFile.downloadTextFile", content, fileName, contentType);
    }

    private async Task DownloadFile(byte[] content, string fileName, string contentType)
    {
        var base64String = Convert.ToBase64String(content);
        await JSRuntime.InvokeVoidAsync("downloadFile.downloadBinaryFile", base64String, fileName, contentType);
    }

    private async Task SelectExport(string exportType)
    {
        isExporting = true;
        showExportDropdown = false;
        StateHasChanged();
        
        try
        {
            // Fetch all invitations matching current filters/search
            var allInvitations = await FetchAllInvitationsForExport();
            
            if (allInvitations.Count == 0)
            {
                errorMessage = "No invitations to export.";
                isExporting = false;
                StateHasChanged();
                return;
            }
            
            var timestamp = DateTime.Now.ToString("yyyyMMdd_HHmmss");
            string fileName;
            string contentType;
            object fileContent;
            
            if (exportType == "CSV")
            {
                fileName = $"invitations_{timestamp}.csv";
                contentType = "text/csv";
                fileContent = GenerateCsvContent(allInvitations);
                await DownloadFile((string)fileContent, fileName, contentType);
            }
            else if (exportType == "Excel")
            {
                fileName = $"invitations_{timestamp}.xlsx";
                contentType = "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
                fileContent = GenerateExcelFile(allInvitations);
                await DownloadFile((byte[])fileContent, fileName, contentType);
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error exporting invitations: {ex.Message}";
        }
        finally
        {
            isExporting = false;
            StateHasChanged();
        }
    }
}
