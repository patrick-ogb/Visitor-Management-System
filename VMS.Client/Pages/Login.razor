@page "/"
@page "/login"
@layout LoginLayout
@using Microsoft.AspNetCore.Components.Web
@inject NavigationManager Navigation
@inject VMS.Client.Services.AuthService AuthService
@inject Blazored.LocalStorage.ILocalStorageService LocalStorage
@inject HttpClient Http

<div class="visitor-management-login-page-container">
    <div class="visitor-management-login-page-visitor-management-login-page">
        <div class="visitor-management-login-page-frame327">
            <img
                src="images/nightrender23721-j5bs-1100h.png"
                alt="NIGHTRENDER23721"
                class="visitor-management-login-page-nightrender2" />
            <div class="visitor-management-login-page-frame346">
                <span class="visitor-management-login-page-text1">
                    Streamline your visitor experience — log in to manage entries,
                    track visits, and ensure secure access to the facility.
                </span>
            </div>
        </div>
        <div class="visitor-management-login-page-group237744">
            <div class="visitor-management-login-page-frame1618868702">
                <img
                    src="images/lfz-logo.png"
                    alt="LFZLOGO2313705"
                    class="visitor-management-login-page-lfzlogo231" />
                <div class="visitor-management-login-page-frame1618868701">
                    <div class="visitor-management-login-page-frame1618868700">
                        <div class="visitor-management-login-page-email1">
                            <span class="visitor-management-login-page-text2">
                                Email
                            </span>
                            <div class="visitor-management-login-page-email2">
                                <input
                                    type="email"
                                    @bind="email"
                                    @bind:event="oninput"
                                    placeholder="Enter your email"
                                    class="visitor-management-login-page-email-input" />
                            </div>
                        </div>
                        <div class="visitor-management-login-page-password1">
                            <span class="visitor-management-login-page-text4">
                                Password
                            </span>
                            <div class="visitor-management-login-page-password2">
                                <input
                                    type="@(showPassword ? "text" : "password")"
                                    @bind="password"
                                    @bind:event="oninput"
                                    placeholder="Enter your password"
                                    class="visitor-management-login-page-password-input" />
                                <img
                                    src="images/viewoffslash.svg"
                                    alt="viewoffslashI3733"
                                    class="visitor-management-login-page-viewoffslash"
                                    @onclick="TogglePasswordVisibility"
                                    role="button"
                                    tabindex="0" />
                            </div>
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            @errorMessage
                        </div>
                    }
                    <button class="visitor-management-login-page-sign-in-button" @onclick="HandleLogin" disabled="@isLoading">
                        <span class="visitor-management-login-page-text6">@(isLoading ? "Logging in..." : "Login")</span>
                    </button>
                    @* Commented out: Registration link removed - users must login to access application *@
                    @* @if (canRegister)
                    {
                        <div class="mt-3">
                            <a href="/register">First time here? Create SUPERADMIN</a>
                        </div>
                    } *@
                </div>
            </div>
        </div>
    </div>
</div>

@code {
