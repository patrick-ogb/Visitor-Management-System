@using VMS.Client.DTOs.Invitations
@using VMS.Client.DTOs.Common
@using VMS.Client.Services
@inject HttpClient Http
@inject IToastService ToastService
@inject IJSRuntime JSRuntime

@if (IsOpen)
{
    <div class="modal-overlay @(IsVisible ? "show" : "hide")" @onclick="Close" @onkeydown="HandleKeyDown">
        <div class="modal-content @(IsVisible ? "show" : "hide")" @onclick:stopPropagation="true">
            <div class="modal-header">
                <h2>Invitation Details</h2>
                <button class="modal-close" @onclick="Close" aria-label="Close" type="button">×</button>
            </div>
            <div class="modal-body">
                @if (SelectedInvitation != null)
                {
                    <div class="details-section">
                        <div class="section-header">
                        <h3 class="section-title">Invitation Information</h3>
                            <button class="btn-initiate-invitation" @onclick="OpenNewInvitationModal" type="button">Initiate new invitation</button>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Invitation No:</span>
                            <span>@SelectedInvitation.InvitationNo</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Status:</span>
                            <span class="badge bg-@GetStatusBadgeClass(SelectedInvitation.Status)">@SelectedInvitation.Status</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Created Date:</span>
                            <span>@SelectedInvitation.CreatedAt.ToString("g")</span>
                        </div>
                    </div>

                    <div class="details-section">
                        <h3 class="section-title">Guest Details</h3>
                        <div class="detail-row">
                            <span class="detail-label">Name:</span>
                            <span>@SelectedInvitation.GuestName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Email:</span>
                            <span>@(SelectedInvitation.GuestEmail ?? "-")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Phone:</span>
                            <span>@SelectedInvitation.GuestPhone</span>
                        </div>
                    </div>

                    <div class="details-section">
                        <h3 class="section-title">Host Information</h3>
                        <div class="detail-row">
                            <span class="detail-label">Host Name:</span>
                            <span>@SelectedInvitation.HostName</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedInvitation.EnterpriseName))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Enterprise:</span>
                                <span>@SelectedInvitation.EnterpriseName</span>
                            </div>
                        }
                    </div>

                    <div class="details-section">
                        <h3 class="section-title">Visit Details</h3>
                        <div class="detail-row">
                            <span class="detail-label">Expected Arrival:</span>
                            <span>@SelectedInvitation.ExpectedArrival.ToString("g")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Expected Departure:</span>
                            <span>@SelectedInvitation.ExpectedDeparture.ToString("g")</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Additional Guests:</span>
                            <span>@SelectedInvitation.NumberOfAdditionalGuests</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(SelectedInvitation.PurposeOfInvitation))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Purpose Of Invitation:</span>
                                <span>@SelectedInvitation.PurposeOfInvitation</span>
                            </div>
                        }
                    </div>

                    @if (SelectedInvitation.IsProxyInvitation)
                    {
                        <div class="details-section">
                            <h3 class="section-title">Proxy Information</h3>
                            <div class="detail-row">
                                <span class="detail-label">Invited On Behalf Of:</span>
                                <span>@(SelectedInvitation.InvitedOnBehalfOf ?? "-")</span>
                            </div>
                        </div>
                    }

                    <div class="details-section">
                        <h3 class="section-title">Vehicles</h3>
                        @if (SelectedInvitation.Vehicles != null && SelectedInvitation.Vehicles.Any())
                        {
                            <div class="vehicles-list">
                                @foreach (var vehicle in SelectedInvitation.Vehicles)
                                {
                                    <div class="vehicle-item">
                                        <div class="vehicle-plate">
                                            <strong>@vehicle.PlateNumber</strong>
                                        </div>
                                        <div class="vehicle-details">
                                            @if (!string.IsNullOrWhiteSpace(vehicle.Model))
                                            {
                                                <span class="vehicle-info">Model: @vehicle.Model</span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(vehicle.Color))
                                            {
                                                <span class="vehicle-info">Color: @vehicle.Color</span>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="no-vehicles">No vehicles registered for this invitation.</p>
                        }
                    </div>
                }
            </div>
            <div class="modal-footer">
                @if (CanCancelInvitation())
                {
                    <button type="button" class="modal-cancel-btn" @onclick="HandleCancelInvitation" disabled="@isCancelling">@(isCancelling ? "Cancelling..." : "Cancel Invitation")</button>
                }
                <button type="button" class="modal-close-btn" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public EventCallback OnInvitationCreated { get; set; }

    private bool IsOpen { get; set; }
    private bool IsVisible { get; set; }
    private InvitationDto? SelectedInvitation { get; set; }
    private NewInvitationModal? newInvitationModal;
    private bool isCancelling = false;

    public void Open(InvitationDto invitation)
    {
        SelectedInvitation = invitation;
        IsOpen = true;
        StateHasChanged();
        
        // Trigger animation after render
        Task.Delay(10).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                IsVisible = true;
                StateHasChanged();
            });
        });
    }

    public void Close()
    {
        IsVisible = false;
        StateHasChanged();
        
        // Wait for animation to complete before removing from DOM
        Task.Delay(300).ContinueWith(_ =>
        {
            InvokeAsync(() =>
            {
                IsOpen = false;
                SelectedInvitation = null;
                StateHasChanged();
            });
        });
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            Close();
        }
    }

    private string GetStatusBadgeClass(string status)
    {
        return status.ToLower() switch
        {
            "approved" => "success",
            "pendingapproval" => "warning",
            "rejected" => "danger",
            "cancelled" => "secondary",
            "checkedin" => "info",
            "expired" => "secondary",
            _ => "secondary"
        };
    }

    private async void OpenNewInvitationModal()
    {
        if (SelectedInvitation != null)
        {
            // Store the invitation data before closing
            var invitationToUse = SelectedInvitation;
            
            // Close the current modal
            Close();
            
            // Wait for the close animation to complete (300ms)
            await Task.Delay(300);
            
            // Open the new invitation modal
            newInvitationModal?.Open(invitationToUse);
        }
    }

    private bool CanCancelInvitation()
    {
        if (SelectedInvitation == null)
            return false;

        // Can cancel if invitation has not been checked in
        // Check both status and CheckedInAt for safety
        var statusLower = SelectedInvitation.Status.ToLower();
        bool isCheckedIn = statusLower == "checkedin" || SelectedInvitation.CheckedInAt.HasValue;
        bool isCancelled = statusLower == "cancelled";
        bool isCompleted = statusLower == "completed";

        return !isCheckedIn && !isCancelled && !isCompleted;
    }

    private async Task HandleCancelInvitation()
    {
        if (SelectedInvitation == null)
            return;

        // Show confirmation dialog
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Are you sure you want to cancel invitation {SelectedInvitation.InvitationNo}?"))
        {
            return;
        }

        isCancelling = true;
        StateHasChanged();

        try
        {
            var response = await Http.PutAsync($"api/Invitations/cancel/{SelectedInvitation.GuestInvitationId}", null);
            
            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<BaseResponse<bool>>();
                if (result != null && result.Success)
                {
                    ToastService.ShowSuccess(result.Message ?? "Invitation cancelled successfully");
                    
                    // Trigger refresh of invitation list
                    await OnInvitationCreated.InvokeAsync();
                    
                    // Close the modal
                    Close();
                }
                else
                {
                    ToastService.ShowError(result?.Message ?? "Failed to cancel invitation");
                }
            }
            else
            {
                var errorResult = await response.Content.ReadFromJsonAsync<BaseResponse<bool>>();
                ToastService.ShowError(errorResult?.Message ?? "Failed to cancel invitation");
            }
        }
        catch (Exception ex)
        {
            ToastService.ShowError($"An error occurred: {ex.Message}");
        }
        finally
        {
            isCancelling = false;
            StateHasChanged();
        }
    }
}

<NewInvitationModal @ref="newInvitationModal" OnInvitationCreated="OnInvitationCreated" />

